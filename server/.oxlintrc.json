{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "rules": {
    "max-lines": ["error", { "max": 700, "skipBlankLines": true, "skipComments": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@schema",
            "importNames": ["projectMembership", "listScopes", "purgedProject"],
            "allowTypeImports": true,
            "message": "Only src/membership/** may import membership schema tables."
          }
        ],
        "patterns": [
          {
            "regex": "(^|/)db/schema$",
            "importNames": ["projectMembership", "listScopes", "purgedProject"],
            "allowTypeImports": true,
            "message": "Only src/membership/** may import membership schema tables."
          }
        ]
      }
    ],
    "typescript/no-floating-promises": ["error", { "checkThenables": true }],
    "typescript/no-misused-promises": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/await-thenable": "error",
    "typescript/only-throw-error": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-base-to-string": "off",
    "typescript/no-misused-spread": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-console": "error",
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["durable-objects/scope.ts"],
      "rules": {
        "max-lines": ["error", { "max": 160, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["tests/**", "scripts/**"],
      "rules": {
        "max-lines": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "typescript/require-array-sort-compare": "off",
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/membership/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+(auth|oauth|sharing|serverops|mcp|ics|mail|routes|crons|middleware)(/|$)",
                "message": "src/sync, src/scope, and src/membership must not import upper layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/sync/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+(auth|oauth|sharing|serverops|mcp|ics|mail|routes|crons|middleware)(/|$)",
                "message": "src/sync, src/scope, and src/membership must not import upper layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/scope/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+(membership|auth|oauth|sharing|serverops|mcp|ics|mail|routes|crons|middleware)(/|$)",
                "message": "src/scope/** must not import src/membership or upper layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "group": ["**", "!./**"],
                "message": "src/domain/** may only import modules within src/domain."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+(oauth|mcp|ics|serverops)(/|$)",
                "message": "src/auth/** must not import oauth, mcp, ics, or serverops."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/serverops/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+(mcp|ics|oauth|sharing|auth)(/|$)",
                "message": "src/serverops/** must not import mcp, ics, oauth, sharing, or auth."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/mcp/tools/**"],
      "rules": {
        "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+sync/(push|pull|merge|entities)(/|$)",
                "allowTypeImports": true,
                "message": "mcp/tools/** and ics/** must not value-import sync/(push|pull|merge|entities)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ics/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              },
              {
                "regex": "^(\\.\\./)+sync/(push|pull|merge|entities)(/|$)",
                "allowTypeImports": true,
                "message": "mcp/tools/** and ics/** must not value-import sync/(push|pull|merge|entities)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/mcp/services.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["routes/**"],
      "rules": {
        "max-lines": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "message": "routes/** must not import the schema; query through src/ modules."
              },
              {
                "name": "void/db",
                "allowImportNames": ["createDb"],
                "message": "routes/** may only import createDb from void/db; query through src/ modules."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "message": "routes/** must not import the schema; query through src/ modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**"],
      "excludeFiles": [
        "src/membership/**",
        "src/sync/**",
        "src/scope/**",
        "src/domain/**",
        "src/auth/**",
        "src/serverops/**",
        "src/mcp/tools/**",
        "src/ics/**",
        "src/mcp/services.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@schema",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)db/schema$",
                "importNames": ["projectMembership", "listScopes", "purgedProject"],
                "allowTypeImports": true,
                "message": "Only src/membership/** may import membership schema tables."
              },
              {
                "regex": "(^|/)durable-objects(/|$)",
                "message": "src/** must not import durable-objects/ (except src/mcp/services.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [".claude/**"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/return-await": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "typescript/unbound-method": "off",
        "typescript/await-thenable": "off",
        "typescript/only-throw-error": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/no-explicit-any": "off",
        "eqeqeq": "off",
        "no-console": "off"
      }
    }
  ]
}
